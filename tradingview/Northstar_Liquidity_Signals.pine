//@version=6
indicator("Northstar Liquidity Signals • NQ/MNQ", shorttitle="Northstar LS", overlay=true, max_labels_count=300, max_lines_count=100)

// Original, rules-based implementation inspired by publicly advertised CDX feature categories.
// This is not CDX source code, does not use an AI model, and does not reproduce its private signals.

string G_SIGNAL = "Signal engine"
int fastLen = input.int(9, "Fast EMA", minval=1, group=G_SIGNAL)
int slowLen = input.int(21, "Slow EMA", minval=2, group=G_SIGNAL)
int rsiLen = input.int(14, "RSI length", minval=2, group=G_SIGNAL)
int pivotLen = input.int(5, "Swing confirmation bars", minval=2, maxval=30, group=G_SIGNAL)
bool useMTF = input.bool(true, "Require higher-timeframe agreement", group=G_SIGNAL)
bool useSweeps = input.bool(true, "Detect liquidity sweep reversals", group=G_SIGNAL)
bool useBreaks = input.bool(true, "Detect swing break continuation", group=G_SIGNAL)

string G_RISK = "Entry / risk levels"
int atrLen = input.int(14, "ATR length", minval=1, group=G_RISK)
float atrBuffer = input.float(0.25, "Stop buffer (ATR)", minval=0.0, step=0.05, group=G_RISK)
float fallbackStop = input.float(1.2, "Fallback stop distance (ATR)", minval=0.1, step=0.1, group=G_RISK)
float tp1R = input.float(1.0, "Take profit 1 (R)", minval=0.25, step=0.25, group=G_RISK)
float tp2R = input.float(2.0, "Take profit 2 (R)", minval=0.5, step=0.25, group=G_RISK)
bool drawTradeLevels = input.bool(true, "Draw entry / stop / targets", group=G_RISK)

string G_LEVELS = "Liquidity levels"
bool showPivots = input.bool(true, "Show confirmed swing levels", group=G_LEVELS)
bool showPriorDay = input.bool(true, "Show previous day high / low", group=G_LEVELS)
bool showSession = input.bool(true, "Show previous RTH high / low", group=G_LEVELS)
string rthSession = input.session("0830-1500", "RTH session (Chicago time)", group=G_LEVELS)

string G_VIS = "Visuals / dashboard"
bool showDashboard = input.bool(true, "Show multi-timeframe dashboard", group=G_VIS)
bool smartCandles = input.bool(true, "Color reversal / compression candles", group=G_VIS)
bool showEMAs = input.bool(false, "Show trend EMAs", group=G_VIS)

// Core calculations
float emaFast = ta.ema(close, fastLen)
float emaSlow = ta.ema(close, slowLen)
float rsi = ta.rsi(close, rsiLen)
float atr = ta.atr(atrLen)
bool trendUp = emaFast > emaSlow
bool trendDown = emaFast < emaSlow

// Confirmed swing points; pivots are intentionally delayed until confirmed.
float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)
var float lastSwingHigh = na
var float lastSwingLow = na
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

bool bullSweep = useSweeps and not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow
bool bearSweep = useSweeps and not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
bool bullBreak = useBreaks and not na(lastSwingHigh) and ta.crossover(close, lastSwingHigh)
bool bearBreak = useBreaks and not na(lastSwingLow) and ta.crossunder(close, lastSwingLow)

// Multi-timeframe trend state. Values use completed/current HTF bars with lookahead disabled.
f_bias() =>
    float f = ta.ema(close, fastLen)
    float s = ta.ema(close, slowLen)
    f > s ? 1 : f < s ? -1 : 0

int b1 = request.security(syminfo.tickerid, "1", f_bias(), lookahead=barmerge.lookahead_off)
int b5 = request.security(syminfo.tickerid, "5", f_bias(), lookahead=barmerge.lookahead_off)
int b15 = request.security(syminfo.tickerid, "15", f_bias(), lookahead=barmerge.lookahead_off)
int b60 = request.security(syminfo.tickerid, "60", f_bias(), lookahead=barmerge.lookahead_off)
int b240 = request.security(syminfo.tickerid, "240", f_bias(), lookahead=barmerge.lookahead_off)
int bD = request.security(syminfo.tickerid, "D", f_bias(), lookahead=barmerge.lookahead_off)
bool mtfBull = b15 >= 0 and b60 >= 0
bool mtfBear = b15 <= 0 and b60 <= 0
bool longSignal = barstate.isconfirmed and trendUp and rsi > 50 and (bullSweep or bullBreak) and (not useMTF or mtfBull)
bool shortSignal = barstate.isconfirmed and trendDown and rsi < 50 and (bearSweep or bearBreak) and (not useMTF or mtfBear)

// Previous daily levels (offset by one completed daily bar).
float priorDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
float priorDayLow = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)

// Track the previous regular-hours session in Chicago time.
bool inRth = not na(time(timeframe.period, rthSession, "America/Chicago"))
bool newRth = inRth and not inRth[1]
var float runningRthHigh = na
var float runningRthLow = na
var float priorRthHigh = na
var float priorRthLow = na
if newRth
    if not na(runningRthHigh)
        priorRthHigh := runningRthHigh
        priorRthLow := runningRthLow
    runningRthHigh := high
    runningRthLow := low
else if inRth
    runningRthHigh := math.max(nz(runningRthHigh, high), high)
    runningRthLow := math.min(nz(runningRthLow, low), low)

plot(showEMAs ? emaFast : na, "Fast EMA", color=color.aqua, linewidth=1)
plot(showEMAs ? emaSlow : na, "Slow EMA", color=color.orange, linewidth=1)
plot(showPivots ? lastSwingHigh : na, "Last confirmed swing high", color=color.new(color.red, 45), style=plot.style_stepline)
plot(showPivots ? lastSwingLow : na, "Last confirmed swing low", color=color.new(color.lime, 45), style=plot.style_stepline)
plot(showPriorDay ? priorDayHigh : na, "Previous day high", color=color.new(color.fuchsia, 15), style=plot.style_linebr)
plot(showPriorDay ? priorDayLow : na, "Previous day low", color=color.new(color.fuchsia, 15), style=plot.style_linebr)
plot(showSession ? priorRthHigh : na, "Previous RTH high", color=color.new(color.yellow, 15), style=plot.style_linebr)
plot(showSession ? priorRthLow : na, "Previous RTH low", color=color.new(color.yellow, 15), style=plot.style_linebr)

// Smart-candle highlighting: rejection wicks and low-range compression.
float candleRange = math.max(high - low, syminfo.mintick)
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
bool bullishReject = lowerWick / candleRange > 0.55 and close > open
bool bearishReject = upperWick / candleRange > 0.55 and close < open
bool compression = candleRange < atr * 0.65
color candleColor = compression ? color.new(color.gray, 15) : bullishReject ? color.new(color.aqua, 0) : bearishReject ? color.new(color.orange, 0) : na
barcolor(smartCandles ? candleColor : na)

plotshape(longSignal, title="Northstar BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 0), text="BUY", textcolor=color.black, size=size.small)
plotshape(shortSignal, title="Northstar SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="SELL", textcolor=color.white, size=size.small)

// Draw a fresh, clearly labeled plan when a confirmed signal appears.
var line entryLine = na
var line stopLine = na
var line target1Line = na
var line target2Line = na
var label entryLabel = na
var label stopLabel = na
var label target1Label = na
var label target2Label = na

if drawTradeLevels and (longSignal or shortSignal)
    line.delete(entryLine)
    line.delete(stopLine)
    line.delete(target1Line)
    line.delete(target2Line)
    label.delete(entryLabel)
    label.delete(stopLabel)
    label.delete(target1Label)
    label.delete(target2Label)

    float entry = close
    bool isLong = longSignal
    float rawStop = isLong ? (na(lastSwingLow) ? entry - atr * fallbackStop : lastSwingLow - atr * atrBuffer) : (na(lastSwingHigh) ? entry + atr * fallbackStop : lastSwingHigh + atr * atrBuffer)
    float stop = isLong ? math.min(rawStop, entry - syminfo.mintick) : math.max(rawStop, entry + syminfo.mintick)
    float risk = math.abs(entry - stop)
    float target1 = isLong ? entry + risk * tp1R : entry - risk * tp1R
    float target2 = isLong ? entry + risk * tp2R : entry - risk * tp2R

    entryLine := line.new(bar_index, entry, bar_index + 25, entry, color=color.white, width=2)
    stopLine := line.new(bar_index, stop, bar_index + 25, stop, color=color.red, width=2)
    target1Line := line.new(bar_index, target1, bar_index + 25, target1, color=color.lime, width=2)
    target2Line := line.new(bar_index, target2, bar_index + 25, target2, color=color.aqua, width=2)
    entryLabel := label.new(bar_index + 25, entry, (isLong ? "LONG ENTRY  " : "SHORT ENTRY  ") + str.tostring(entry, format.mintick), style=label.style_label_left, color=color.new(color.blue, 0), textcolor=color.white)
    stopLabel := label.new(bar_index + 25, stop, "STOP  " + str.tostring(stop, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white)
    target1Label := label.new(bar_index + 25, target1, "TP1  " + str.tostring(target1, format.mintick), style=label.style_label_left, color=color.green, textcolor=color.white)
    target2Label := label.new(bar_index + 25, target2, "TP2  " + str.tostring(target2, format.mintick), style=label.style_label_left, color=color.teal, textcolor=color.white)

// Dashboard
var table dash = table.new(position.top_right, 2, 8, border_width=1, frame_color=color.new(color.gray, 65))
f_stateText(int v) => v > 0 ? "BULLISH" : v < 0 ? "BEARISH" : "NEUTRAL"
f_stateColor(int v) => v > 0 ? color.new(color.green, 15) : v < 0 ? color.new(color.red, 15) : color.new(color.gray, 35)
if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "NORTHSTAR • MTF", bgcolor=color.rgb(18, 31, 47), text_color=color.white)
    table.cell(dash, 1, 0, syminfo.ticker, bgcolor=color.rgb(18, 31, 47), text_color=color.white)
    table.cell(dash, 0, 1, "1 MIN", text_color=color.white)
    table.cell(dash, 1, 1, f_stateText(b1), bgcolor=f_stateColor(b1), text_color=color.white)
    table.cell(dash, 0, 2, "5 MIN", text_color=color.white)
    table.cell(dash, 1, 2, f_stateText(b5), bgcolor=f_stateColor(b5), text_color=color.white)
    table.cell(dash, 0, 3, "15 MIN", text_color=color.white)
    table.cell(dash, 1, 3, f_stateText(b15), bgcolor=f_stateColor(b15), text_color=color.white)
    table.cell(dash, 0, 4, "1 HOUR", text_color=color.white)
    table.cell(dash, 1, 4, f_stateText(b60), bgcolor=f_stateColor(b60), text_color=color.white)
    table.cell(dash, 0, 5, "4 HOUR", text_color=color.white)
    table.cell(dash, 1, 5, f_stateText(b240), bgcolor=f_stateColor(b240), text_color=color.white)
    table.cell(dash, 0, 6, "DAILY", text_color=color.white)
    table.cell(dash, 1, 6, f_stateText(bD), bgcolor=f_stateColor(bD), text_color=color.white)
    table.cell(dash, 0, 7, "RSI / ATR", text_color=color.white)
    table.cell(dash, 1, 7, str.tostring(rsi, "#.0") + " / " + str.tostring(atr, format.mintick), bgcolor=color.new(color.blue, 75), text_color=color.white)
if not showDashboard and barstate.islast
    table.clear(dash, 0, 0, 1, 7)

// Alerts
alertcondition(longSignal, title="Northstar BUY setup", message="Northstar BUY setup on {{ticker}} {{interval}}. Review chart entry, stop and targets.")
alertcondition(shortSignal, title="Northstar SELL setup", message="Northstar SELL setup on {{ticker}} {{interval}}. Review chart entry, stop and targets.")
